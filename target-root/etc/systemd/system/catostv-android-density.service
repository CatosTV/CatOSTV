# CatosTV: size Android's layout for the TV, see
# /usr/local/lib/catostv/android-tv-density. Started by the TV shell as
#   systemctl --no-ask-password start --no-block catostv-android-density.service
# which /etc/polkit-1/rules.d/50-catostv-android.rules allows for the active
# local `catostv` session (verb "start" only).

[Unit]
Description=CatosTV: TV-sized Android layout
Requires=waydroid-container.service
After=waydroid-container.service

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /usr/local/lib/catostv/android-tv-density
TimeoutStartSec=60
