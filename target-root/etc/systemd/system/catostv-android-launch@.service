# CatosTV: open a TV-only Android app, see /usr/local/lib/catostv/android-launch.
# Started by the TV shell as
#   systemctl --no-ask-password start catostv-android-launch@<package>.service
# which /etc/polkit-1/rules.d/50-catostv-android.rules allows for the active
# local `catostv` session (verb "start" of this template only).

[Unit]
Description=CatosTV: open Android app %i
Requires=waydroid-container.service
After=waydroid-container.service

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /usr/local/lib/catostv/android-launch %i
TimeoutStartSec=30
