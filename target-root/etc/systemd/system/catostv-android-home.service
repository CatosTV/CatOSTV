# CatosTV: send Android to its home screen when you leave an Android app,
# see /usr/local/lib/catostv/android-home. Started by the TV shell as
#   systemctl --no-ask-password start --no-block catostv-android-home.service
# which /etc/polkit-1/rules.d/50-catostv-android.rules allows for the active
# local `catostv` session (verb "start" only).

[Unit]
Description=CatosTV: send Android to its home screen
Requires=waydroid-container.service
After=waydroid-container.service

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /usr/local/lib/catostv/android-home
TimeoutStartSec=20
