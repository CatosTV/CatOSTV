# Kernel command line parameters CatosTV adds to the boot entry of an
# installed system: one per line, "#" starts a comment.
#
# The installer reads this file when it writes the boot entry, and
# boot-params-sync adds missing ones to TVs that were installed earlier
# (post-install runs it on every update). Parameters are only ever added.
# The live ISO's grub.cfg keeps its own short list of the same ones.

# No lockup detectors (NMI watchdog and soft lockup): fewer timer
# interrupts. This does not touch hardware watchdog chips.
nowatchdog

# Full kernel preemption for lower scheduling latency of the compositor,
# remote input and audio. A no-op where the kernel is already built with it.
preempt=full

# AMD CPPC frequency scaling for Zen 2 and newer. Ignored on other CPUs.
amd_pstate=active
