#!/usr/bin/env bash
# CatosTV: what this version needs set up on a system once its files are in
# place. Run as root by the installer (inside the new system) and by the
# updater (on the TV), so whatever a release adds reaches new installs from
# an older ISO and existing TVs alike, CatosTV ships rolling, the ISO is
# only a starting point. Must be safe to run any number of times.
#
# Add each release's new setup steps here, never only to the installer.
set -uo pipefail
# Units that come with the overlay.
systemctl enable catostv-android-watch.service catostv-debug-boot.service 2>/dev/null || true
# GTK / libadwaita TV defaults (/etc/dconf/db/local.d).
dconf update 2>/dev/null || true
exit 0
