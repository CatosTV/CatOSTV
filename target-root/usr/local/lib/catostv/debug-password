#!/usr/bin/env bash
# CatosTV Settings → Debug → Change password. Run as root by
# catostv-debug-password.service. Input: /run/catostv/debug/password, a
# regular file the TV account wrote (mode 0600). It is read once and
# deleted; the password never appears on a command line or in a log.
set -euo pipefail
F=/run/catostv/debug/password
[ -f "$F" ] && [ ! -L "$F" ] || { echo "no password staged" >&2; exit 1; }
[ "$(stat -c %U "$F")" = catostv ] || { rm -f "$F"; echo "staged by the wrong account" >&2; exit 1; }
pw=$(head -c 512 "$F")
rm -f "$F"
n=${#pw}
case "$pw" in *:*|*[[:cntrl:]]*) echo "colons and control characters can't be used" >&2; exit 1 ;; esac
if [ "$n" -lt 4 ] || [ "$n" -gt 128 ]; then echo "use 4 to 128 characters" >&2; exit 1; fi
printf 'catostv:%s\n' "$pw" | chpasswd
mkdir -p /var/lib/catostv/debug
touch /var/lib/catostv/debug/password-changed
echo "password changed"
