#!/usr/bin/env bash
# CatosTV: look after Android's keystore before Android starts, and start
# Android over on request.
#
# Run as root before every waydroid-container start (systemd drop-in), and
# with --force by catostv-android-repair.service (Settings → Android → Repair
# Android, after the confirmation sheet).
#
# Without --force:
#  * keystore files are given back to Android's keystore user (uid 1017)
#    if something re-owned them;
#  * the keystore database gets a real integrity check. Waydroid stops
#    Android with a kill, so keystore2's write-ahead log (-wal/-shm) is
#    usually still there: that is NORMAL, and the check must open the
#    database read-write so SQLite replays it. The old read-only check
#    could not, reported an error, and the script then "repaired" a
#    healthy keystore by deleting it, which loses the lock-settings
#    protector key and leaves Android crashing at every boot ("SP
#    protector key is missing"). Nothing is deleted here any more:
#    a database that really is damaged is reported in
#    /run/catostv/android-keystore-broken for the shell to offer Repair.
#
# With --force (Repair Android): Android starts over. Its whole data
# folder is moved aside (one previous copy kept) and recreated by the next
# session start: apps and sign-ins inside Android go, the image stays, and
# the keystore and lock settings are made together again, consistently.
# Deleting the keystore alone can never be a repair.
set -u
force=0
[[ "${1:-}" == "--force" ]] && force=1
readonly LIB_DIR=/var/lib/catostv/android
readonly BROKEN_FLAG=/run/catostv/android-keystore-broken
mkdir -p /run/catostv
log() { echo "android-keystore-check: $*"; }

data_dirs() {
  local d
  for d in /home/*/.local/share/waydroid/data /var/lib/waydroid/data; do
    [[ -d "$d" ]] && printf '%s\n' "$d"
  done
}

if (( force )); then
  # The repair unit stopped waydroid-container.service first; a session
  # that is still winding down must be gone before the folder moves.
  for _ in $(seq 1 20); do
    [[ "$(lxc-info -P /var/lib/waydroid/lxc -n waydroid -sH 2>/dev/null)" == RUNNING ]] || break
    sleep 1
  done
  stamp=$(date +%Y%m%d-%H%M%S)
  while IFS= read -r data; do
    parent=$(dirname "$data")
    # One previous copy only (they are large).
    for old in "$parent"/data.previous-*; do
      [[ -d "$old" ]] && rm -rf "$old"
    done
    if mv "$data" "$parent/data.previous-$stamp"; then
      log "moved $data to $parent/data.previous-$stamp (Android starts over)"
    else
      log "could not move $data aside"
    fi
  done < <(data_dirs)
  # Android TV's first-run setup is finished on the fresh data at the next
  # boot by android-tv-density (the shell's density unit, every boot), not
  # here: Android is not running and its new /data does not exist yet.
  # Identity and app fingerprints of the old Android.
  rm -f "$LIB_DIR/gsf-id" /run/catostv/android-apps "$BROKEN_FLAG"
  exit 0
fi

rm -f "$BROKEN_FLAG"
while IFS= read -r data; do
  d="$data/misc/keystore"
  [[ -d "$d" ]] || continue
  db="$d/persistent.sqlite"
  if find "$d" -mindepth 1 ! -uid 1017 | grep -q .; then
    log "fixing keystore file owners in $d"
    chown -R 1017:1017 "$d"
    chmod 700 "$d"
  fi
  [[ -f "$db" ]] || continue
  result=$(python3 -I - "$db" <<'PY' 2>&1
import sqlite3, sys
try:
    # Read-write on purpose: a write-ahead log left by Android's last stop
    # is replayed, as keystore2 itself would do. Android is not running.
    con = sqlite3.connect(sys.argv[1], timeout=10)
    print(con.execute("PRAGMA quick_check").fetchone()[0])
    con.close()
except sqlite3.DatabaseError as e:
    print(f"database error: {e}")
except Exception as e:
    print(f"error: {e}")
PY
)
  # Files SQLite may have created while checking belong to keystore too.
  chown -R 1017:1017 "$d" 2>/dev/null
  case "$result" in
    ok) ;;
    *"malformed"*|*"not a database"*|*"corrupt"*)
      log "keystore database at $db is damaged: $result, Android will not start until it is repaired (Settings → Android → Repair Android)"
      printf '%s\n' "$result" >"$BROKEN_FLAG"
      chmod 644 "$BROKEN_FLAG"
      ;;
    *)
      log "could not check $db ($result): leaving it alone"
      ;;
  esac
done < <(data_dirs)
exit 0
